{
  "name": "durak-na-vahte",
  "version": "1.11.0",
  "private": true,
  "description": "Офлайн дурак с вахтовыми происшествиями",
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node tests/rules.test.cjs && node tests/simulate.cjs",
    "test:browser": "node tests/browser.cjs",
    "serve": "python3 -m http.server 8080 --bind 127.0.0.1",
    "package": "node scripts/package.cjs",
    "test:selects": "node tests/selects.cjs",
    "test:mobile": "node tests/mobile.cjs",
    "test:gestures": "node tests/gestures.cjs",
    "test:events": "node tests/event-effects.test.cjs && node tests/event-motion.cjs",
    "test:motion": "node tests/motion.cjs",
    "test:crew": "node tests/crew.cjs",
    "test:viewport": "node tests/viewport.cjs",
    "test:loss": "node tests/loss-banter.test.cjs && node tests/loss-screen.cjs",
    "test:results": "node tests/results-layout.cjs",
    "test:table": "node tests/table-layout.cjs",
    "test:dialogue": "node tests/dialogue.test.cjs && node tests/dialogue-browser.cjs",
    "test:camera": "node tests/camera.cjs",
    "test:cache": "node tests/cache-updates.cjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
